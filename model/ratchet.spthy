/*
  Tamarin model of the Ratchet-USB session opening and ratchet.

  Scope
  ─────
  This models the classical half of the handshake (X25519 / X3DH) and the
  Double Ratchet it seeds. The post-quantum half is abstracted to a second
  Diffie-Hellman term: a real ML-KEM-768 encapsulation and SPQR's internal
  encoding are not modelled, only their contribution to the root of the
  ratchet, which is that the attacker cannot derive it without breaking the
  KEM. A separate model would be needed for SPQR itself.

  What is proved
  ──────────────
    * session_key_secrecy      the X3DH output stays secret
    * message_secrecy          a ratcheted message stays secret
    * forward_secrecy          a state reveal does not expose an earlier message
    * post_compromise_security a fresh DH ratchet step heals after a state reveal
    * injective_agreement_*    the two sides agree on the peer they reached
    * one_time_prekey_single_use

  What is not proved
  ──────────────────
  * Tamarin is symbolic (Dolev-Yao). It proves the protocol logic, not the
    computational security of ChaCha20-Poly1305, HKDF, X25519 or ML-KEM.
  * It does not prove that src/session.cpp or the Rust SPQR bridge match this
    model. The model is a design check, not a refinement proof.

  Run
  ───
    tamarin-prover --prove model/ratchet.spthy
*/

theory RatchetUSB
begin

builtins: diffie-hellman, signing, symmetric-encryption

// The key-derivation function, treated as a one-way symbol: the attacker can
// apply it to what it knows but cannot invert it, which is what the ratchet
// relies on.
functions: kdf/1

// ── long-term identity, PQ identity and signed prekeys ───────────────────────

rule Register_identity:
  [ Fr(~ik), Fr(~pqik), Fr(~sig) ]
  -->
  [ !Ltk($A, ~ik), !Pk($A, 'g'^~ik),
    !PqLtk($A, ~pqik), !PqPk($A, 'g'^~pqik),
    !Sign($A, ~sig), !Vf($A, pk(~sig)) ]

rule Gen_signed_prekey:
  [ Fr(~spk), !Sign($A, sig) ]
  -->
  [ !Spk($A, ~spk),
    !SpkPub($A, 'g'^~spk, sign(<'spk', 'g'^~spk>, sig)) ]

// One-time prekeys are linear: using one consumes it, so it cannot be
// replayed into a second session.
rule Gen_one_time_prekey:
  [ Fr(~opk) ]
  -->
  [ OneTimePrekey($A, ~opk), !OneTimePrekeyPub($A, 'g'^~opk) ]

// ── attacker capabilities ────────────────────────────────────────────────────

rule Reveal_ltk:
  [ !Ltk(A, ik) ] --[ RevealLtk(A) ]-> [ Out(ik) ]

rule Reveal_pq_ltk:
  [ !PqLtk(A, pqik) ] --[ RevealPqLtk(A) ]-> [ Out(pqik) ]

rule Reveal_signed_prekey:
  [ !Spk(A, spk) ] --[ RevealSpk(A) ]-> [ Out(spk) ]

rule Reveal_one_time_prekey:
  [ OneTimePrekey(A, opk) ] --[ RevealOpk(A) ]-> [ Out(opk) ]

// State compromise: everything a running device holds.
rule Reveal_state_init:
  [ StateInit(A, B, st) ] --[ RevealState(A, B) ]-> [ Out(st) ]

rule Reveal_state_resp:
  [ StateResp(A, B, st) ] --[ RevealStateResp(A, B) ]-> [ Out(st) ]

// ── the opening (X3DH) ───────────────────────────────────────────────────────
//
// After the handshake both sides hold a root key `rk` and the first link of
// the sending/receiving chain. The message that opens the session is keyed by
// the first chain link; the state keeps the *next* one, so revealing it later
// cannot walk back to that message.

rule Opening_initiator:
  let sk  = kdf(< 'g'^(ikA * spkB),
                  'g'^(ek  * ikB),
                  'g'^(ek  * spkB),
                  'g'^(ek  * opkB),
                  'g'^(pqek * pqikB) >)
      rk  = kdf(< sk, 'g'^(rat_i * spkB) >)
      ck0 = kdf(< rk, 'chain' >)
      mk0 = kdf(< ck0, 'msg' >)
      ck1 = kdf(< ck0, 'chain' >)
  in
  [ Fr(~ek), Fr(~pqek), Fr(~rat_i), Fr(~m),
    !Ltk($A, ikA),
    !Pk($B, ikB),
    !PqPk($B, pqikB),
    !SpkPub($B, spkB, sig),
    !Vf($B, vk),
    !OneTimePrekeyPub($B, opkB) ]
  --[ Init($A, $B, spkB),
      Eq(verify(sig, <'spk', spkB>, vk), true),
      SecretSession(<$A, $B, sk>),
      SecretMessage(<$A, $B, ~m>) ]->
  [ Out(< 'g'^~ek, 'g'^~pqek, 'g'^ikA, spkB, opkB, 'g'^rat_i, senc(~m, mk0) >),
    StateInit($A, $B, < rk, ck1, ~rat_i >) ]

rule Opening_responder:
  let sk  = kdf(< 'g'^(ikB * spkB),
                  'g'^(ikB * gx_ek),
                  'g'^(spkB * gx_ek),
                  'g'^(opkB * gx_ek),
                  'g'^(pqikB * gx_pqek) >)
      rk  = kdf(< sk, 'g'^(spkB * rat_i) >)
      ck0 = kdf(< rk, 'chain' >)
      mk0 = kdf(< ck0, 'msg' >)
      ck1 = kdf(< ck0, 'chain' >)
  in
  [ !Ltk($B, ikB),
    !PqLtk($B, pqikB),
    !Spk($B, spkB),
    OneTimePrekey($B, opkB),
    In(< gx_ek, gx_pqek, gx_ikA, spkB_pub, opk_pub, rat_i, senc(m, mk0) >),
    Fr(~rat_r) ]
  --[ Resp($B, gx_ikA, spkB),
      Eq(spkB_pub, 'g'^spkB),
      Eq(opk_pub, 'g'^opkB),
      ConsumedOneTimePrekey($B, opk_pub) ]->
  [ Out('g'^~rat_r),
    StateResp($B, gx_ikA, < rk, ck1, ~rat_r >) ]

// ── the symmetric chain ──────────────────────────────────────────────────────
//
// A message advances the chain key and is keyed by the link it consumed. The
// state never holds that link again, so a later reveal cannot expose it.

rule Send_message:
  let mk  = kdf(< ck, 'msg' >)
      ck2 = kdf(< ck, 'chain' >)
  in
  [ StateInit($A, $B, < rk, ck, rat >), Fr(~m) ]
  --[ RatchetMessage(< $A, $B, ~m >) ]->
  [ Out(senc(~m, mk)),
    StateInit($A, $B, < rk, ck2, rat >) ]

rule Receive_message:
  let mk  = kdf(< ck, 'msg' >)
      ck2 = kdf(< ck, 'chain' >)
  in
  [ StateResp($B, gx_ikA, < rk, ck, rat >), In(senc(m, mk)) ]
  --[ RatchetMessageResp(< $B, gx_ikA, m >) ]->
  [ StateResp($B, gx_ikA, < rk, ck2, rat >) ]

// ── the DH ratchet ───────────────────────────────────────────────────────────
//
// A fresh DH against the peer's ratchet key produces a new root and chain. The
// fresh secret is not in the state, which is what heals a compromise.

rule Dh_ratchet_init:
  let rk2 = kdf(< rk, 'g'^(new_rat * peer_rat) >)
      ck2 = kdf(< rk2, 'chain' >)
  in
  [ StateInit($A, $B, < rk, ck, rat >), Fr(~new_rat), !Pk($R, peer_rat) ]
  --[ DhStep($A, $B) ]->
  [ Out('g'^~new_rat),
    StateInit($A, $B, < rk2, ck2, ~new_rat >) ]

rule Dh_ratchet_resp:
  let rk2 = kdf(< rk, 'g'^(new_rat * rat) >)
      ck2 = kdf(< rk2, 'chain' >)
  in
  [ StateResp($B, gx_ikA, < rk, ck, rat >), In('g'^new_rat), Fr(~my_new_rat) ]
  --[ DhStepResp($B, gx_ikA) ]->
  [ Out('g'^~my_new_rat),
    StateResp($B, gx_ikA, < rk2, ck2, ~my_new_rat >) ]

// ── lemmas ───────────────────────────────────────────────────────────────────

lemma session_key_secrecy:
  "All A B sk #i. SecretSession(<A, B, sk>) @ i ==> not (Ex #j. K(sk) @ j)"

lemma message_secrecy:
  "All A B m #i. SecretMessage(<A, B, m>) @ i ==> not (Ex #j. K(m) @ j)"

// Forward secrecy: revealing a state after a message does not expose it. The
// state holds only the *next* chain link, which the KDF does not invert.
lemma forward_secrecy:
  "All A B m #i #j.
     SecretMessage(<A, B, m>) @ i & RevealState(A, B) @ j & i < j
     ==> not (Ex #k. K(m) @ k)"

// Post-compromise security: after a state reveal, a fresh DH step heals the
// chain, so a message sent afterwards (and before the next reveal) is secret.
lemma post_compromise_security:
  "All A B m #i #h #j.
     RevealState(A, B) @ i
   & DhStep(A, B) @ h
   & RatchetMessage(< A, B, m >) @ j
   & i < h & h < j
   & not (Ex #r. RevealState(A, B) @ r & h < r & r < j)
   ==> not (Ex #k. K(m) @ k)"

lemma post_compromise_security_resp:
  "All A B m #i #h #j.
     RevealStateResp(A, B) @ i
   & DhStepResp(A, B) @ h
   & RatchetMessageResp(< A, B, m >) @ j
   & i < h & h < j
   & not (Ex #r. RevealStateResp(A, B) @ r & h < r & r < j)
   ==> not (Ex #k. K(m) @ k)"

// Authentication: the two sides agree on the peer they reached.
lemma injective_agreement_resp:
  "All A B spkB #i. Resp(B, A, spkB) @ i
     ==> (Ex #j. Init(A, B, spkB) @ j & j < i)"

lemma injective_agreement_init:
  "All A B spkB #i. Init(A, B, spkB) @ i
     ==> (Ex #j. Resp(B, A, spkB) @ j)"

// A one-time prekey is used at most once.
lemma one_time_prekey_single_use:
  "All B opk #i #j.
     ConsumedOneTimePrekey(B, opk) @ i & ConsumedOneTimePrekey(B, opk) @ j
     ==> #i = #j"

end
