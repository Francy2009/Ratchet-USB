build/
build-*/
cmake-build-*/
*.o
*.a
compile_commands.json
.cache/
__pycache__/
rust/spqr_bridge/target/
third_party/spqr/target/

# Fuzzer output: the inputs it discovers and the ones that failed. The corpus
# under test/fuzz/corpus is committed and curated by hand; this is the scratch
# it writes to, and none of it belongs in the tree.
.fuzz-out/
crash-*
oom-*
timeout-*
leak-*

# Never let a real vault or a seed near the repository.
vault.bin
vault.bin.tmp
*.seed

# Never commit a release signing key. The CI key lives in GitHub Secrets.
minisign.key
minisign-ci.key
